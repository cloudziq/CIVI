[memory]

limits/command_queue/multithreading_queue_size_kb=512

[physics]

3d/physics_engine="GodotPhysics"
3d/default_gravity=0.0
common/physics_fps=120
3d/active_soft_world=false

[rendering]

environment/defaults/default_clear_color=Color(0.439216, 0.439216, 0.439216, 1)
environment/defaults/default_environment="res://def_env.tres"
quality/driver/driver_name="GLES2"
quality/shadow_atlas/cubemap_size=1024
lights_and_shadows/shadow_atlas/quadrant_0_subdiv=2
quality/shadows/filter_mode=2
quality/filters/anisotropic_filter_level=1
batching/options/single_rect_fallback=true
batching/lights/max_join_items=64
