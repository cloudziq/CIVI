; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CIVI"
run/main_scene="res://data/tscn/SYST.tscn"
config/features=PackedStringArray("4.4")
run/delta_smoothing=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=false
boot_splash/image="res://logo.png"
config/icon="res://logo.png"

[autoload]

G="*res://data/tscn/GLOBAL_DATA.gd"

[display]

window/size/viewport_width=1480
window/size/viewport_height=640
window/size/always_on_top=true
window/stretch/mode="viewport"
window/vsync/vsync_mode=false

[filesystem]

import/blender/enabled=false

[gui]

common/drop_mouse_on_gui_input_disabled=true

